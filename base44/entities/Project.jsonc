{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android"
      ],
      "default": "ios"
    },
    "device": {
      "type": "string",
      "default": "iphone-6.7",
      "description": "Device size id"
    },
    "custom_w": {
      "type": "number"
    },
    "custom_h": {
      "type": "number"
    },
    "template_id": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": true,
      "description": "Independent feature-graphic slide (kept separate from phone slides)"
    },
    "uploads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}