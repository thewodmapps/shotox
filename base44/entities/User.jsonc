{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "default": "user"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro"
      ],
      "default": "free"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "free_downloads": {
      "type": "number",
      "default": 0,
      "description": "Number of exports used by free-tier users; gated against FREE_MAX_DOWNLOADS"
    }
  },
  "required": []
}