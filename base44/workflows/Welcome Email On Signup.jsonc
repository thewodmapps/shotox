{
  "name": "Welcome Email On Signup",
  "description": "Sends a welcome email exactly once to each app user \u2014 fires on signup, and on login as a catch-up for users who signed up before the workflow existed. Dedup via EmailLog (campaign 'welcome').",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup",
        "login"
      ]
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email_on_signup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_welcome": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmail",
            "args": {
              "user_id": "${ .trigger.user_id }",
              "email": "${ .trigger.email }",
              "full_name": "${ .trigger.full_name }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome email",
            "description": "Editor link + quick start to new user"
          }
        }
      }
    ]
  }
}